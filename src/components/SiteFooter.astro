---
import footerLogoUrl from '../assets/images/logos/logotype-white.svg?url';

const navigation = [
	{ title: 'Brand system', href: '/brand-system/' },
	{ title: 'Contribute', href: '/contribute/' },
	{ title: 'Photography', href: '/photography/' },
	{ title: 'License', href: '/license/' },
];
---

<footer class="bg-sign-black px-5 py-20 text-paper-white md:px-8 md:py-28">
	<div class="mx-auto max-w-[1600px]">
		<div
			class="flex flex-col items-start gap-2 font-mono text-[10px] uppercase leading-loose tracking-[0.08em] md:flex-row md:justify-between md:gap-6 md:tracking-[0.12em]"
		>
			<p>Toledo, Ohio<br />United States</p>
			<p class="text-left md:text-right">41.6639° N<br />83.5552° W</p>
		</div>

		<div
			class="mt-6 flex flex-col items-start gap-6 border-t border-paper-white/40 pt-8 md:mt-8 md:flex-row md:items-center md:justify-between md:gap-10"
		>
			<img src={footerLogoUrl} alt="You Will Do Better in Toledo" class="w-24 shrink-0 md:w-32" />
			<nav
				aria-label="Footer navigation"
				class="flex flex-col items-start gap-1 font-mono text-[10px] uppercase tracking-[0.08em] md:flex-row md:items-center md:justify-end md:gap-10 md:whitespace-nowrap md:text-xs md:tracking-[0.12em]"
			>
				{
					navigation.map((item) => (
						<a
							class="border-b border-transparent py-2 transition-colors duration-200 hover:border-current"
							href={item.href}
						>
							{item.title}
						</a>
					))
				}
			</nav>
		</div>

		<div class="mt-16">
			<p class="max-w-3xl text-sm font-medium leading-relaxed md:text-base">
				Except where otherwise credited, this website, brand system, and its assets are open source
				and released into the public domain under <a
					href="https://creativecommons.org/publicdomain/zero/1.0/"
					target="_blank"
					rel="license noopener noreferrer"
					class="underline underline-offset-4 transition-colors duration-200 hover:text-foundry-orange"
					>CC0 1.0</a
				>. <a
					href="/license/"
					class="underline underline-offset-4 transition-colors duration-200 hover:text-foundry-orange"
					>Read about the license.</a
				>
			</p>
		</div>

		<p
			class="mt-14 font-mono text-[9px] leading-relaxed tracking-[0.02em] text-paper-white/70 sm:whitespace-nowrap md:text-[10px]"
		>
			AI-assisted design and development tools helped shape this website and its vision as a public
			resource toward the public good.
		</p>
	</div>
</footer>
