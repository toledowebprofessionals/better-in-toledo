---
interface Props {
	label: string;
	description: string;
}
const { label, description } = Astro.props;
---

<header class="brand-introduction">
	<h1>{label}</h1>
	<div>{description}</div>
</header>

<style>
	.brand-introduction > h1 {
		border-top: 1px solid #161616;
		padding-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 500;
	}
	.brand-introduction > div {
		max-width: 48rem;
		margin-top: clamp(2rem, 3vw, 3rem);
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		line-height: 1.55;
	}
	@media (max-width: 899px) {
		.brand-introduction > h1 {
			border-top: 0;
		}
	}
</style>
