---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface HeadlineLine {
	text: string;
	accent?: string;
}

interface Props {
	imageSrc: ImageMetadata;
	imageWidth: number;
	imageHeight: number;
	imageAlt: string;
	location: string;
	coordinates: string;
	headlineLines: HeadlineLine[];
	supportingCopy: string;
	photoCredit: string;
	photoCreditUrl: string;
	photoLicense: string;
	photoLicenseUrl: string;
	ctaLabel: string;
	ctaHref: string;
}

const {
	imageSrc,
	imageWidth,
	imageHeight,
	imageAlt,
	location,
	coordinates,
	headlineLines,
	supportingCopy,
	photoCredit,
	photoCreditUrl,
	photoLicense,
	photoLicenseUrl,
	ctaLabel,
	ctaHref,
} = Astro.props;
---

<section
	class="relative flex min-h-[60svh] flex-col overflow-hidden bg-sign-black px-5 text-paper-white md:min-h-[115svh] md:px-8"
>
	<Image
		src={imageSrc}
		alt={imageAlt}
		width={imageWidth}
		height={imageHeight}
		format="webp"
		quality={80}
		loading="eager"
		fetchpriority="high"
		class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center grayscale brightness-[0.58] contrast-125 md:object-[center_58%]"
	/>
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-b from-sign-black/60 via-sign-black/25 to-sign-black"
	>
	</div>
	<div
		class="relative mx-auto flex w-full max-w-[1600px] grow flex-col justify-end pb-4 pt-10 md:pb-8 md:pt-32"
	>
		<div
			class="mb-auto flex flex-col items-start gap-1 border-t border-paper-white/50 pt-3 font-mono text-[10px] uppercase tracking-[0.12em] md:flex-row md:justify-between md:gap-6 md:text-xs"
		>
			<span>{location}</span>
			<span>{coordinates}</span>
		</div>
		<h1
			class="font-display text-[clamp(5.3rem,15.5vw,15rem)] font-extrabold uppercase leading-[0.77] tracking-[-0.025em]"
		>
			{
				headlineLines.map((line, index) => (
					<>
						{index > 0 && <br />}
						{line.text}
						{line.accent && (
							<>
								{' '}
								<span class="text-foundry-orange">{line.accent}</span>
							</>
						)}
					</>
				))
			}
		</h1>
	</div>
</section>

<section class="bg-sign-black px-5 py-12 text-paper-white md:px-8 md:py-16">
	<div class="mx-auto max-w-[1600px]">
		<div
			class="grid gap-10 border-t border-paper-white/50 pt-8 md:grid-cols-12 md:items-end md:pt-10"
		>
			<div class="max-w-xl md:col-span-6">
				<p class="max-w-lg text-lg leading-relaxed md:text-xl">{supportingCopy}</p>
				<p
					class="mt-6 font-mono text-[10px] uppercase leading-relaxed tracking-[0.08em] text-paper-white/70"
				>
					Photo: <a
						class="underline underline-offset-2 hover:text-glass-blue"
						href={photoCreditUrl}
						target="_blank"
						rel="noopener noreferrer">{photoCredit}</a
					>{' · '}
					<a
						class="underline underline-offset-2 hover:text-glass-blue"
						href={photoLicenseUrl}
						target="_blank"
						rel="license noopener noreferrer">{photoLicense}</a
					>
				</p>
			</div>
			<a
				href={ctaHref}
				class="group flex items-center justify-between border border-paper-white px-5 py-4 font-mono text-xs uppercase tracking-[0.12em] transition-colors hover:bg-paper-white hover:text-sign-black md:col-span-3 md:col-start-10"
			>
				<span class="button-label">{ctaLabel}</span>
				<span
					class="button-icon text-lg transition-transform group-hover:translate-x-1"
					aria-hidden="true">→</span
				>
			</a>
		</div>
	</div>
</section>
