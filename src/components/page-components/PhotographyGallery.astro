---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photograph {
	title: string;
	file: string;
	preview: ImageMetadata;
	downloadHref: string;
	width: number;
	height: number;
	source: string;
	sourceTitle: string;
	contributor: string;
	description: string;
	license: string;
	copyrightNotice: string;
}

interface Props {
	photographs: Photograph[];
}

const { photographs } = Astro.props;
---

<section class="photo-grid" aria-label="Archival photographs">
	{
		photographs.map((photo, index) => (
			<article class="photo-card">
				<div class="photo-card__image">
					<Image
						src={photo.preview}
						alt={photo.title}
						width={640}
						format="webp"
						quality={75}
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
					<button
						class="photo-card__inspect"
						type="button"
						data-open-dialog={`photo-${index}`}
						aria-label={`View details for ${photo.title}`}
						aria-haspopup="dialog"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<>
								<circle cx="11" cy="11" r="6.5" />
								<path d="m16 16 5 5" />
							</>
						</svg>
					</button>
				</div>
				<div class="photo-card__information">
					<div>
						<>
							<h2>{photo.title}</h2>
							<p>
								{photo.sourceTitle} / {photo.contributor}
							</p>
						</>
					</div>
					<a
						href={photo.downloadHref}
						download={photo.file}
						aria-label={`Download ${photo.title}`}
						title="Download image"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 3v13M7 11l5 5 5-5M4 21h16" />
						</svg>
					</a>
				</div>
			</article>
		))
	}
</section>

{
	photographs.map((photo, index) => (
		<dialog
			class="photo-dialog"
			id={`photo-${index}`}
			aria-labelledby={`photo-${index}-title`}
			aria-describedby={`photo-${index}-description`}
		>
			<div class="photo-dialog__panel">
				<div class="photo-dialog__image">
					<Image
						src={photo.preview}
						alt={photo.title}
						width={1400}
						format="webp"
						quality={82}
						loading="lazy"
					/>
				</div>
				<div class="photo-dialog__details">
					<button
						class="photo-dialog__close"
						type="button"
						data-close-dialog
						aria-label="Close image details"
						autofocus
					>
						Close <span aria-hidden="true">×</span>
					</button>
					<p class="photo-dialog__label">Archive image / {String(index + 1).padStart(2, '0')}</p>
					<h2 id={`photo-${index}-title`}>{photo.title}</h2>
					<p id={`photo-${index}-description`} class="photo-dialog__description">
						{photo.description}
					</p>
					<dl>
						<div>
							<>
								<dt>Source</dt>
								<dd>
									<a href={photo.source} target="_blank" rel="noopener noreferrer">
										{photo.sourceTitle} ↗
									</a>
								</dd>
							</>
						</div>
						<div>
							<>
								<dt>Contributor</dt>
								<dd>{photo.contributor}</dd>
							</>
						</div>
						<div>
							<>
								<dt>License</dt>
								<dd>{photo.license}</dd>
							</>
						</div>
						<div>
							<>
								<dt>Copyright notice</dt>
								<dd>{photo.copyrightNotice}</dd>
							</>
						</div>
					</dl>
					<div class="photo-dialog__actions">
						<a href={photo.downloadHref} download={photo.file}>
							<span class="button-label">Download image</span>
							<span class="button-icon" aria-hidden="true">
								↓
							</span>
						</a>
					</div>
				</div>
			</div>
		</dialog>
	))
}

<style>
	.photo-grid {
		display: grid;
		width: 100%;
		max-width: 1600px;
		gap: clamp(1rem, 1.5vw, 1.5rem);
		margin: clamp(2rem, 3vw, 3rem) auto 0;
	}
	.photo-card {
		min-width: 0;
		border: 1px solid #161616;
		background: #faf9f5;
	}
	.photo-card__image {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #161616;
	}
	.photo-card__image > img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.35s ease,
			filter 0.35s ease;
	}
	.photo-card:hover .photo-card__image > img {
		transform: scale(1.025);
		filter: brightness(0.72);
	}
	.photo-card__inspect {
		position: absolute;
		inset: 0;
		display: flex;
		cursor: zoom-in;
		align-items: center;
		justify-content: center;
		color: #f4f1e8;
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.photo-card__inspect svg {
		width: 3rem;
		height: 3rem;
		padding: 0.7rem;
		border: 1px solid currentColor;
		background: rgb(22 22 22 / 55%);
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.photo-card:hover .photo-card__inspect,
	.photo-card__inspect:focus-visible {
		opacity: 1;
	}
	.photo-card__information {
		display: flex;
		min-height: 8.5rem;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem;
	}
	.photo-card__information h2 {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}
	.photo-card__information p {
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		line-height: 1.55;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: rgb(22 22 22 / 65%);
	}
	.photo-card__information > a {
		flex: 0 0 auto;
		padding: 0.5rem;
		border: 1px solid #161616;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.photo-card__information > a:hover {
		background: #161616;
		color: #f4f1e8;
	}
	.photo-card__information svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.photo-dialog {
		width: min(94vw, 1500px);
		max-width: none;
		max-height: 92vh;
		margin: auto;
		padding: 0;
		border: 0;
		background: #161616;
		color: #f4f1e8;
	}
	.photo-dialog::backdrop {
		background: rgb(0 0 0 / 82%);
		backdrop-filter: blur(4px);
	}
	.photo-dialog__panel {
		display: grid;
		max-height: 92vh;
	}
	.photo-dialog__image {
		display: flex;
		min-height: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding: clamp(1rem, 3vw, 3rem);
		background: #0d0d0d;
	}
	.photo-dialog__image img {
		width: 100%;
		height: 100%;
		max-height: 84vh;
		object-fit: contain;
	}
	.photo-dialog__details {
		position: relative;
		overflow-y: auto;
		padding: clamp(1.5rem, 3vw, 3rem);
	}
	.photo-dialog__close {
		display: flex;
		width: max-content;
		cursor: pointer;
		align-items: center;
		gap: 0.55rem;
		margin-left: auto;
		border-bottom: 1px solid rgb(244 241 232 / 35%);
		padding-bottom: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.photo-dialog__close span {
		font-size: 1.25rem;
		line-height: 1;
	}
	.photo-dialog__label {
		margin-top: 2rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(244 241 232 / 55%);
	}
	.photo-dialog__details h2 {
		margin-top: 1rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.5vw, 2.5rem);
		font-weight: 700;
		line-height: 0.95;
		text-transform: uppercase;
	}
	.photo-dialog__description {
		margin-top: 2rem;
		font-size: 1rem;
		line-height: 1.65;
	}
	.photo-dialog dl {
		margin-top: 2rem;
		border-top: 1px solid rgb(244 241 232 / 35%);
	}
	.photo-dialog dl div {
		display: grid;
		gap: 0.5rem;
		border-bottom: 1px solid rgb(244 241 232 / 20%);
		padding-block: 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1.5;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.photo-dialog dt {
		color: rgb(244 241 232 / 50%);
	}
	.photo-dialog dd a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.photo-dialog dd a:hover {
		color: #d96832;
	}
	.photo-dialog__actions {
		display: grid;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.photo-dialog__actions a {
		display: flex;
		justify-content: space-between;
		border: 1px solid #f4f1e8;
		padding: 0.9rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.photo-dialog__actions a:hover {
		background: #f4f1e8;
		color: #161616;
	}
	@media (min-width: 640px) {
		.photo-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 900px) {
		.photo-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.photo-dialog__panel {
			grid-template-columns: minmax(0, 2fr) minmax(22rem, 1fr);
		}
		.photo-dialog dl div {
			grid-template-columns: 9rem 1fr;
		}
	}
	@media (min-width: 1400px) {
		.photo-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.photo-card__image > img {
			transition: none;
		}
	}
</style>

<script>
	const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]');
	const closeButtons = document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]');
	let activeDialogTrigger: HTMLButtonElement | null = null;

	const closeDialog = (dialog: HTMLDialogElement) => {
		dialog.close();
		document.body.style.overflow = '';
	};

	openButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const dialog = document.getElementById(
				button.dataset.openDialog ?? '',
			) as HTMLDialogElement | null;
			if (dialog) {
				activeDialogTrigger = button;
				dialog.showModal();
				document.body.style.overflow = 'hidden';
			}
		});
	});

	closeButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const dialog = button.closest('dialog');
			if (dialog) closeDialog(dialog);
		});
	});

	document.querySelectorAll<HTMLDialogElement>('.photo-dialog').forEach((dialog) => {
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeDialog(dialog);
		});
		dialog.addEventListener('close', () => {
			document.body.style.overflow = '';
			activeDialogTrigger?.focus();
			activeDialogTrigger = null;
		});
	});
</script>
