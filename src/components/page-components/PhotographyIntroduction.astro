---
interface Props {
	pageLabel: string;
	description: string;
	ctaLabel: string;
	ctaHref: string;
}

const { pageLabel, description, ctaLabel, ctaHref } = Astro.props;
---

<header class="page-introduction">
	<h1 class="page-label">{pageLabel}</h1>
	<p class="introduction">{description}</p>
	<a class="introduction-contribute" href={ctaHref}
		><span class="button-label">{ctaLabel}</span>
		<span class="button-icon" aria-hidden="true">↗</span></a
	>
</header>

<style>
	.page-introduction {
		width: 100%;
		max-width: 1600px;
		margin-inline: auto;
	}
	.page-label {
		border-top: 1px solid #161616;
		padding-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 500;
	}
	.introduction {
		max-width: 48rem;
		margin-top: clamp(2rem, 3vw, 3rem);
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		line-height: 1.55;
	}
	.introduction-contribute {
		display: flex;
		width: 100%;
		max-width: 23rem;
		align-items: center;
		justify-content: space-between;
		margin-top: 1.75rem;
		border: 1px solid #161616;
		padding: 0.95rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.introduction-contribute:hover {
		background: #161616;
		color: #f4f1e8;
	}
	.introduction-contribute span {
		transition: transform 0.2s ease;
	}
	.introduction-contribute:hover span {
		transform: translate(0.2rem, -0.2rem);
	}
</style>
