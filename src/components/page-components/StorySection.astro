---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	sectionLabel: string;
	contextLabel: string;
	headline: string;
	headlineAccent: string;
	imageSrc: ImageMetadata;
	imageAlt: string;
	imageWidth: number;
	imageHeight: number;
	caption: string;
	captionLocation: string;
	leadCopy: string;
	paragraphs: string[];
	closingCopy: string;
	citationAuthors: string;
	citationTitle: string;
	citationUrl: string;
}

const {
	sectionLabel,
	contextLabel,
	headline,
	headlineAccent,
	imageSrc,
	imageAlt,
	imageWidth,
	imageHeight,
	caption,
	captionLocation,
	leadCopy,
	paragraphs,
	closingCopy,
	citationAuthors,
	citationTitle,
	citationUrl,
} = Astro.props;
---

<section class="bg-[#faf9f5] px-5 py-20 md:px-8 md:py-32">
	<div class="mx-auto max-w-[1600px]">
		<div
			class="flex flex-col items-start gap-1 border-t border-sign-black pt-3 font-mono text-[10px] uppercase tracking-[0.12em] md:flex-row md:items-center md:justify-between md:gap-6 md:text-xs"
		>
			<span>{sectionLabel}</span>
			<span>{contextLabel}</span>
		</div>

		<h2
			class="my-16 font-display text-6xl font-extrabold uppercase leading-[0.84] tracking-[-0.035em] md:my-24 md:text-[clamp(6rem,10vw,10rem)]"
		>
			<span class="lg:whitespace-nowrap">{headline}</span><br />
			<span class="text-foundry-orange">{headlineAccent}</span>
		</h2>

		<figure>
			<div class="overflow-hidden bg-steel-gray">
				<Image
					src={imageSrc}
					alt={imageAlt}
					width={imageWidth}
					height={imageHeight}
					format="webp"
					quality={76}
					loading="lazy"
					class="h-auto w-full grayscale"
				/>
			</div>
			<figcaption
				class="flex flex-col items-start gap-1 border-b border-sign-black py-3 font-mono text-[9px] uppercase tracking-[0.1em] md:flex-row md:justify-between md:gap-6 md:text-[10px]"
			>
				<span>{caption}</span>
				<span>{captionLocation}</span>
			</figcaption>
		</figure>

		<div class="grid gap-12 py-16 md:grid-cols-12 md:gap-8 md:py-28">
			<p
				class="font-display text-4xl font-bold uppercase leading-[0.95] tracking-[-0.02em] md:col-span-5 md:text-6xl"
			>
				{leadCopy}
			</p>

			<div class="space-y-7 text-base leading-[1.75] md:col-span-5 md:col-start-8 md:text-lg">
				{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p class="font-medium">{closingCopy}</p>
				<aside
					class="border-l-2 border-foundry-orange pl-4 font-mono text-[9px] uppercase leading-relaxed tracking-[0.06em] text-sign-black/65 md:text-[10px]"
				>
					Source: {citationAuthors}, <a
						href={citationUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="underline underline-offset-2 hover:text-maumee-blue"
						><cite>{citationTitle}</cite></a
					>.
				</aside>
			</div>
		</div>
	</div>
</section>
