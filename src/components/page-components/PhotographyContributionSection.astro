---
interface Props {
	sectionLabel: string;
	headline: string;
	paragraphs: string[];
	licenseLabel: string;
	licenseHref: string;
	ctaLabel: string;
	ctaHref: string;
}

const { sectionLabel, headline, paragraphs, licenseLabel, licenseHref, ctaLabel, ctaHref } =
	Astro.props;
---

<section class="photo-call">
	<p class="photo-call__label">{sectionLabel}</p>
	<div class="photo-call__grid">
		<h2>{headline}</h2>
		<div>
			<p>{paragraphs[0]}</p>
			<p>
				Contributed photographs must be your original work and ready to be released into the public
				domain under <a href={licenseHref}>{licenseLabel}</a>. {paragraphs[1]}
			</p>
			<a class="photo-call__button" href={ctaHref}
				><span class="button-label">{ctaLabel}</span>
				<span class="button-icon" aria-hidden="true">↗</span></a
			>
		</div>
	</div>
</section>

<style>
	.photo-call {
		width: 100%;
		max-width: 1600px;
		margin: clamp(4rem, 8vw, 8rem) auto 0;
		padding: clamp(2rem, 5vw, 5rem);
		background: #161616;
		color: #f4f1e8;
	}
	.photo-call__label {
		border-top: 1px solid rgb(244 241 232 / 45%);
		padding-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.photo-call__grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 5rem);
		margin-top: clamp(3rem, 6vw, 6rem);
	}
	.photo-call h2 {
		max-width: 8ch;
		font-family: var(--font-display);
		font-size: clamp(3.75rem, 8vw, 8rem);
		font-weight: 800;
		line-height: 0.78;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}
	.photo-call__grid > div > p {
		max-width: 40rem;
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.photo-call__grid > div > p + p {
		margin-top: 1.25rem;
	}
	.photo-call__grid p a {
		text-decoration: underline;
		text-decoration-color: #d96832;
		text-underline-offset: 0.25em;
	}
	.photo-call__grid p a:hover {
		color: #d96832;
	}
	.photo-call__button {
		display: flex;
		width: 100%;
		max-width: 20rem;
		align-items: center;
		justify-content: space-between;
		margin-top: 2rem;
		border: 1px solid #f4f1e8;
		padding: 0.95rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.photo-call__button:hover {
		background: #f4f1e8;
		color: #161616;
	}
	.photo-call__button span {
		transition: transform 0.2s ease;
	}
	.photo-call__button:hover span {
		transform: translate(0.2rem, -0.2rem);
	}
	@media (min-width: 900px) {
		.photo-call__grid {
			grid-template-columns: minmax(0, 3fr) minmax(22rem, 2fr);
			align-items: start;
		}
	}
</style>
