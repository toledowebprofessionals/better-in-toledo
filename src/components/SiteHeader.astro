---
import headerLogoUrl from '../assets/images/logos/logo-frame-white.svg?url';

const navigation = [
	{ title: 'Brand system', href: '/brand-system/' },
	{ title: 'Contribute', href: '/contribute/' },
	{ title: 'Photography', href: '/photography/' },
	{ title: 'License', href: '/license/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/brand-system/' ? currentPath.startsWith('/brand-system/') : currentPath === href;
---

<header class="relative z-20 bg-sign-black px-5 text-paper-white md:px-8">
	<div class="mx-auto flex max-w-[1600px] items-center justify-between py-3 md:py-4">
		<a href="/" aria-label="You Will Do Better in Toledo, home" class="block w-28 md:w-32">
			<img src={headerLogoUrl} alt="" />
		</a>
		<button
			class="mobile-menu-button"
			type="button"
			aria-label="Open navigation menu"
			aria-haspopup="dialog"
			aria-controls="mobile-navigation"
			aria-expanded="false"
			data-open-mobile-menu
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
		<nav
			aria-label="Primary navigation"
			class="hidden items-center justify-end gap-8 font-mono text-xs uppercase tracking-[0.12em] md:flex"
		>
			{
				navigation.map((item) => (
					<a
						class:list={[
							'border-b py-2 transition-colors duration-200',
							isActive(item.href)
								? 'border-foundry-orange text-foundry-orange'
								: 'border-transparent hover:border-current',
						]}
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
					>
						{item.title}
					</a>
				))
			}
		</nav>
	</div>
</header>

<dialog class="mobile-menu" id="mobile-navigation" aria-labelledby="mobile-navigation-title">
	<div class="mobile-menu__inner">
		<div class="mobile-menu__header">
			<h2 id="mobile-navigation-title">Menu</h2>
			<button
				class="mobile-menu__close"
				type="button"
				aria-label="Close navigation menu"
				data-close-mobile-menu
				autofocus
			>
				<span aria-hidden="true">×</span>
			</button>
		</div>
		<nav aria-label="Mobile navigation" class="mobile-menu__navigation">
			{
				navigation.map((item, index) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
						data-mobile-menu-link
					>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<strong>{item.title}</strong>
					</a>
				))
			}
		</nav>
		<p class="mobile-menu__location">Toledo, Ohio<br />United States</p>
	</div>
</dialog>

<style>
	.mobile-menu-button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		cursor: pointer;
		place-content: center;
		gap: 0.3rem;
		border: 1px solid rgb(244 241 232 / 55%);
	}
	.mobile-menu-button span {
		display: block;
		width: 1.15rem;
		height: 1px;
		background: currentColor;
	}
	.mobile-menu {
		position: fixed;
		inset: 0 0 0 auto;
		width: min(88vw, 24rem);
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: #161616;
		color: #f4f1e8;
		opacity: 0;
		transform: translateX(100%);
		transition:
			transform 0.3s ease,
			opacity 0.3s ease;
	}
	.mobile-menu[open] {
		opacity: 1;
		transform: translateX(0);
	}
	.mobile-menu.is-closing {
		opacity: 0;
		transform: translateX(100%);
	}
	.mobile-menu::backdrop {
		background: rgb(0 0 0 / 72%);
		backdrop-filter: blur(2px);
	}
	@starting-style {
		.mobile-menu[open] {
			opacity: 0;
			transform: translateX(100%);
		}
	}
	.mobile-menu__inner {
		display: flex;
		height: 100%;
		flex-direction: column;
		padding: 1.25rem;
	}
	.mobile-menu__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid rgb(244 241 232 / 40%);
		padding-bottom: 1rem;
	}
	.mobile-menu__header h2,
	.mobile-menu__location {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.mobile-menu__close {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		cursor: pointer;
		place-content: center;
		border: 1px solid rgb(244 241 232 / 55%);
	}
	.mobile-menu__close span {
		font-size: 1.75rem;
		font-weight: 300;
		line-height: 1;
	}
	.mobile-menu__navigation {
		margin-top: 0;
	}
	.mobile-menu__navigation a {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: 1rem;
		align-items: baseline;
		border-bottom: 1px solid rgb(244 241 232 / 30%);
		padding-block: 1.25rem;
		font-family: var(--font-mono);
		text-transform: uppercase;
	}
	.mobile-menu__navigation a span {
		font-size: 0.65rem;
	}
	.mobile-menu__navigation a strong {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1;
	}
	.mobile-menu__navigation a:hover,
	.mobile-menu__navigation a[aria-current='page'] {
		color: #d96832;
	}
	.mobile-menu__location {
		margin-top: auto;
		padding-top: 2rem;
		line-height: 1.7;
		color: rgb(244 241 232 / 70%);
	}
	@media (min-width: 768px) {
		.mobile-menu-button,
		.mobile-menu {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-menu {
			transition: none;
		}
	}
</style>

<script>
	const menu = document.querySelector<HTMLDialogElement>('#mobile-navigation');
	const openMenuButton = document.querySelector<HTMLButtonElement>('[data-open-mobile-menu]');
	const closeMenuButton = document.querySelector<HTMLButtonElement>('[data-close-mobile-menu]');
	const mobileMenuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-link]');
	let closeTimer: number | undefined;

	const finishClosingMenu = () => {
		if (!menu?.open) return;
		menu.classList.remove('is-closing');
		menu.close();
	};

	const closeMenu = (animate = true) => {
		if (!menu?.open) return;
		window.clearTimeout(closeTimer);
		if (!animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			finishClosingMenu();
			return;
		}
		menu.classList.add('is-closing');
		closeTimer = window.setTimeout(finishClosingMenu, 300);
	};

	openMenuButton?.addEventListener('click', () => {
		if (!menu) return;
		menu.showModal();
		openMenuButton.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	});

	closeMenuButton?.addEventListener('click', () => closeMenu());
	mobileMenuLinks.forEach((link) => link.addEventListener('click', () => closeMenu(false)));

	menu?.addEventListener('cancel', (event) => {
		event.preventDefault();
		closeMenu();
	});
	menu?.addEventListener('click', (event) => {
		if (event.target === menu) closeMenu();
	});
	menu?.addEventListener('close', () => {
		window.clearTimeout(closeTimer);
		menu.classList.remove('is-closing');
		document.body.style.overflow = '';
		openMenuButton?.setAttribute('aria-expanded', 'false');
		openMenuButton?.focus();
	});

	window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
		if (event.matches) closeMenu(false);
	});
</script>
